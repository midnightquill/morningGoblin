{
  "name": "discord-morning-bot",
  "version": "1.0.0",
  "description": "A funny little Discord bot that nags people to say good morning.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "watchdog": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/watchdog.ps1",
    "watchdog:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-watchdog.ps1",
    "check": "node scripts/check.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "discord.js": "^14.19.3",
    "dotenv": "^16.4.7"
  }
}
